# Cache-busting for JS/CSS bundles — prevent stale code on redeploy
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is revalidated on every load (ensures new bundles are loaded). no-cache, not no-store (skills audit #4, 2026-10-23):
# no-store keeps the page out of the back/forward cache, so a back or forward navigation reloaded the whole app.
/index.html
  Cache-Control: no-cache

/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
