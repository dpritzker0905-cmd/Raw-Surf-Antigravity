+      const b = run(NARROW).result;
+      expect(b).toEqual(a);
+    });
+
+    it('the cached mask is POST-close — a hit must not skip the close and leak a raw mask', () => {
+      // Close is idempotent on a closed mask, so miss-then-hit and miss-then-miss must agree.
